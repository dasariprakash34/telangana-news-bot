# tgnews environment. Placeholders only. Never commit real values.
# In GitHub Actions these come from repository secrets/variables, not from this file.

# --- Behaviour (repository variables in Actions) ---
# review = drafts go to Telegram for approval; auto = publishes without approval. Keep review at launch.
MODE=review
# Maximum posts per day (positive integer; default 5).
DAILY_CAP=5
# Page name shown on the images.
BRAND_NAME=Telangana News
# Comma-separated UTC HH:MM posting slots. Default matches the cron times in .github/workflows/post.yml.
TIME_SLOTS=00:30,01:00,01:30,02:00,02:30,03:00,03:30,04:00,04:30,05:00,05:30,06:00,06:30,07:00,07:30,08:00,08:30,09:00,09:30,10:00,10:30,11:00,11:30,12:00,12:30,13:00,13:30,14:00,14:30,15:00,15:30,16:00,16:30,17:00,17:30,18:00
# How many of the slots are active each day (positive integer; default 3).
ACTIVE_SLOT_COUNT=36
# Put a source credit line (మూలం: ...) in every caption: true (default) or false. With false the model is told not to name the source.
REQUIRE_SOURCE_CREDIT=true
# Most posts/drafts one run may create (positive integer; default ceil(DAILY_CAP / ACTIVE_SLOT_COUNT)).
PER_RUN_CAP=2

# --- Database ---
# Hosted Postgres URL for Actions. A provider URL starting with postgres:// or postgresql:// is rewritten to
# postgresql+psycopg:// automatically; other schemes (e.g. sqlite) are left as they are. sqlite is for local dry-runs only.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# --- LLM (rewriting and the weekly report) ---
# Provider: gemini (default; Google AI Studio free tier, no cost) or anthropic (optional, pay-as-you-go,
# needs: pip install -e ".[anthropic]"). Repository variable in Actions.
LLM_PROVIDER=gemini
# Model id. REQUIRED for gemini, no default: copy a current Flash or Flash-Lite model id from Google AI Studio.
# Optional for anthropic (defaults to the id in src/tgnews/rewrite.py). Repository variable in Actions.
LLM_MODEL=your-gemini-flash-model-id
# Google AI Studio API key (secret). Needed when LLM_PROVIDER=gemini.
GEMINI_API_KEY=your-gemini-api-key
# Anthropic API key (secret). Only needed when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Instagram ---
# Long-lived Instagram user token (after the first refresh the newest token is kept in the database).
IG_ACCESS_TOKEN=your-instagram-access-token
# Instagram account (user) ID of the page that posts.
IG_USER_ID=your-instagram-user-id
# Graph API version shown in the Meta dashboard, written like v23.0. Required, no default.
IG_API_VERSION=vNN.N

# --- Image storage ---
# Where rendered JPEGs are hosted (Instagram needs a public https URL). github (default, free) or s3.
STORAGE_PROVIDER=github

# github: commit images into a separate PUBLIC GitHub repo (anything committed there is public).
# Fine-grained personal access token limited to the images repo, Contents read/write (secret in Actions).
# The name must not start with GITHUB_ (GitHub forbids such Actions secret names).
IMAGES_GH_TOKEN=your-images-repo-token
# The images repo as owner/name (repository variable in Actions).
IMAGES_GH_REPO=your-user/tgnews-images
# Branch to commit to (default main).
IMAGES_GH_BRANCH=main
# Optional https base URL for the image links, e.g. https://cdn.jsdelivr.net/gh/your-user/tgnews-images@main
# Default: https://raw.githubusercontent.com/OWNER/REPO/BRANCH
IMAGES_PUBLIC_BASE=
# Days to keep images before `tgnews prune-images` deletes them (default 14; must exceed the 6-hour draft expiry).
IMAGES_KEEP_DAYS=14

# s3 (optional advanced backend, only read when STORAGE_PROVIDER=s3): S3-compatible bucket, public read.
# S3 API endpoint URL of your provider.
STORAGE_ENDPOINT=https://your-s3-endpoint.example
# Access key ID with write access to the bucket.
STORAGE_ACCESS_KEY_ID=your-storage-access-key-id
# Secret access key for the key above.
STORAGE_SECRET_ACCESS_KEY=your-storage-secret-access-key
# Bucket name.
STORAGE_BUCKET=your-bucket-name
# Public HTTPS base URL that serves the bucket's images (must start with https://).
STORAGE_PUBLIC_BASE=https://images.example.com
# Optional region; defaults to "auto".
STORAGE_REGION=auto

# --- Telegram (review mode and alerts) ---
# Bot token from BotFather.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Chat ID of the PRIVATE chat that approves posts (anyone in this chat can approve).
TELEGRAM_CHAT_ID=your-telegram-chat-id

# --- Optional local overrides (not used by the workflows) ---
# Path to the RSS sources file (default config/sources.yaml).
SOURCES_PATH=config/sources.yaml
# Directory for rendered images (default: a temporary directory).
OUT_DIR=./out

# Testing only: set the repository variable IGNORE_SLOTS=true to make `tgnews run` ignore the active-slot check. Remove it afterwards.
IGNORE_SLOTS=
