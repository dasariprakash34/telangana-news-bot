# tgnews environment. Placeholders only. Never commit real values.
# In GitHub Actions these come from repository secrets/variables, not from this file.

# --- Behaviour (repository variables in Actions) ---
# review = drafts go to Telegram for approval; auto = publishes without approval. Keep review at launch.
MODE=review
# Maximum posts per day (positive integer; default 5).
DAILY_CAP=5
# Page name shown on the images.
BRAND_NAME=Telangana News
# Comma-separated UTC HH:MM posting slots. Default matches the cron times in .github/workflows/post.yml.
TIME_SLOTS=02:00,07:00,13:00,15:30
# How many of the slots are active each day (positive integer; default 3).
ACTIVE_SLOT_COUNT=3

# --- Database ---
# Hosted Postgres URL for Actions. A provider URL starting with postgres:// or postgresql:// is rewritten to
# postgresql+psycopg:// automatically; other schemes (e.g. sqlite) are left as they are. sqlite is for local dry-runs only.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# --- Claude ---
# Anthropic API key (rewriting and the weekly report).
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Instagram ---
# Long-lived Instagram user token (after the first refresh the newest token is kept in the database).
IG_ACCESS_TOKEN=your-instagram-access-token
# Instagram account (user) ID of the page that posts.
IG_USER_ID=your-instagram-user-id
# Graph API version shown in the Meta dashboard, written like v23.0. Required, no default.
IG_API_VERSION=vNN.N

# --- Image storage (S3-compatible, public read for the image prefix) ---
# S3 API endpoint URL of your provider.
STORAGE_ENDPOINT=https://your-s3-endpoint.example
# Access key ID with write access to the bucket.
STORAGE_ACCESS_KEY_ID=your-storage-access-key-id
# Secret access key for the key above.
STORAGE_SECRET_ACCESS_KEY=your-storage-secret-access-key
# Bucket name.
STORAGE_BUCKET=your-bucket-name
# Public HTTPS base URL that serves the bucket's images (must start with https://).
STORAGE_PUBLIC_BASE=https://images.example.com
# Optional region; defaults to "auto".
STORAGE_REGION=auto

# --- Telegram (review mode and alerts) ---
# Bot token from BotFather.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Chat ID of the PRIVATE chat that approves posts (anyone in this chat can approve).
TELEGRAM_CHAT_ID=your-telegram-chat-id

# --- Optional local overrides (not used by the workflows) ---
# Path to the RSS sources file (default config/sources.yaml).
SOURCES_PATH=config/sources.yaml
# Directory for rendered images (default: a temporary directory).
OUT_DIR=./out
